/**
 * App.tsx
 * Top-level routing shell for Eduportal NG.
 *
 * Routing logic (in order):
 * 1. Read subdomain â†’ query schools by slug
 * 2. If no school found â†’ SchoolNotFound
 * 3. If school found but no auth session â†’ LoginPage
 * 4. If authenticated but onboarding not complete â†’ OnboardingWizard
 * 5. If authenticated and onboarded â†’ MainApp (with BottomNav)
 *
 * All loading states use skeleton screens, not spinners.
 * No browser-only APIs in routing logic.
 */

import { useEffect, useState } from 'react'
import { supabase } from './lib/supabase'
import { useAuthStore } from './stores/authStore'
import { LoginPage } from './routes/LoginPage'
import { OnboardingWizard } from './routes/OnboardingWizard'
import { BottomNav, type NavTab } from './components/BottomNav'
import AdminDashboard from './routes/AdminDashboard'

// â”€â”€â”€ School data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

interface SchoolData {
  id: string
  name: string
  slug: string
  logo_url: string | null
  theme_color: string | null
  status: string
  onboarding_complete: boolean
}

// â”€â”€â”€ Subdomain detection â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function getSlugFromHostname(hostname: string): string | null {
  // Local dev: {slug}.localhost â€” 2 labels, first is the slug
  if (hostname.endsWith('.localhost')) {
    const parts = hostname.split('.')
    if (parts[0] !== 'localhost') return parts[0]
  } else {
    // Production: {slug}.eduportalng.com â€” 3+ labels means a subdomain is present.
    // A bare apex domain (eduportalng.com) or www.eduportalng.com has only 2
    // meaningful labels and must NOT be treated as a school slug.
    const parts = hostname.split('.')
    if (parts.length >= 3 && parts[0] !== 'www') {
      return parts[0]
    }
  }
  // Dev fallback: ?slug=dilimi in URL params
  if (typeof window !== 'undefined') {
    const params = new URLSearchParams(window.location.search)
    return params.get('slug')
  }
  return null
}

// â”€â”€â”€ App entry point â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

export default function App() {
  const [school, setSchool] = useState<SchoolData | null>(null)
  const [slugState, setSlugState] = useState<'loading' | 'not-found' | 'found' | 'no-slug'>('loading')
  const [activeTab, setActiveTab] = useState<NavTab>('home')
  const [forceShowOnboarding, setForceShowOnboarding] = useState(false)

  const { session, actorType, isLoading: authLoading, isInitialized, initialize } = useAuthStore()

  // Initialize auth once on mount
  useEffect(() => {
    initialize()
  }, [initialize])

  // Load school from subdomain
  useEffect(() => {
    const slug = getSlugFromHostname(window.location.hostname)
    if (!slug) {
      setSlugState('no-slug')
      return
    }

    supabase
      .from('schools')
      .select('id, name, slug, logo_url, theme_color, status, onboarding_complete')
      .eq('slug', slug)
      .maybeSingle()
      .then(({ data }) => {
        if (!data) {
          setSlugState('not-found')
        } else {
          setSchool(data)
          setSlugState('found')
          // Apply school theme color to CSS variable
          if (data.theme_color) {
            document.documentElement.style.setProperty('--color-brand-600', data.theme_color)
          }
        }
      })
  }, [])

  // â”€â”€â”€ Loading skeleton â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  if (slugState === 'loading' || !isInitialized || authLoading) {
    return (
      <div className="app-loading">
        <div className="skeleton-logo" />
        <div className="skeleton-line" style={{ width: '60%' }} />
        <div className="skeleton-line" style={{ width: '40%' }} />
      </div>
    )
  }

  // â”€â”€â”€ No subdomain â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  if (slugState === 'no-slug') {
    return (
      <div className="platform-home">
        <div className="platform-home-inner">
          <h1 className="platform-home-title">Eduportal NG</h1>
          <p className="platform-home-desc">
            School management platform for Nigerian schools.
          </p>
          <p className="platform-home-hint">
            Access your school at <strong>yourschool.eduportalng.com</strong>
          </p>
        </div>
      </div>
    )
  }

  // â”€â”€â”€ School not found â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  if (slugState === 'not-found' || !school) {
    return (
      <div className="school-not-found">
        <div className="not-found-inner">
          <span className="not-found-icon">ðŸ«</span>
          <h1>School not found</h1>
          <p>
            We couldn't find a school at this address. Check the URL or contact the school for the correct link.
          </p>
        </div>
      </div>
    )
  }

  // â”€â”€â”€ School suspended or archived â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  if (school.status === 'suspended') {
    return (
      <div className="school-suspended">
        <div className="suspended-inner">
          <span className="suspended-icon">âš ï¸</span>
          <h1>{school.name}</h1>
          <p>This school's account is currently suspended. Please contact the school administration.</p>
        </div>
      </div>
    )
  }

  // â”€â”€â”€ Not logged in â†’ Login â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  if (!session) {
    return (
      <LoginPage
        schoolId={school.id}
        schoolName={school.name}
        logoUrl={school.logo_url}
        themeColor={school.theme_color}
      />
    )
  }

  // â”€â”€â”€ Onboarding not complete â†’ Wizard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  if (!school.onboarding_complete || forceShowOnboarding) {
    return (
      <OnboardingWizard
        schoolId={school.id}
        schoolName={school.name}
        onComplete={() => {
          setSchool({ ...school, onboarding_complete: true })
          setForceShowOnboarding(false)
        }}
      />
    )
  }

  // â”€â”€â”€ Main app shell â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  return (
    <div className="app-shell">
      {/* Top header */}
      <header className="app-header">
        <div className="app-header-left">
          {school.logo_url && (
            <img src={school.logo_url} alt={school.name} className="app-header-logo" />
          )}
          <span className="app-header-school-name">{school.name}</span>
        </div>
        <div className="app-header-right">
          <button
            className="icon-btn"
            onClick={() => setActiveTab('more')}
            aria-label="Account"
          >
            ðŸ‘¤
          </button>
        </div>
      </header>

      {/* Page content â€” module views loaded here */}
      <main className="app-main">
        <TabContent
          tab={activeTab}
          schoolId={school.id}
          actorType={actorType}
          onOpenSetup={() => setForceShowOnboarding(true)}
        />
      </main>

      {/* Bottom navigation */}
      <BottomNav
        activeTab={activeTab}
        onNavigate={setActiveTab}
        actorType={actorType}
      />
    </div>
  )
}

// â”€â”€â”€ Tab content router â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function TabContent({
  tab,
  schoolId,
  actorType,
  onOpenSetup,
}: {
  tab: NavTab
  schoolId: string
  actorType: 'staff' | 'guardian' | 'student' | 'platform_admin' | null
  onOpenSetup: () => void
}) {
  const isAdmin = actorType === 'staff' || actorType === 'platform_admin'

  // â”€â”€ Home / Dashboard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if (tab === 'home') {
    // Admin and staff see the full AdminDashboard.
    // Guardian/student home views are placeholders until Phase 6 builds them.
    if (isAdmin) {
      return <AdminDashboard />
    }
    return (
      <PlaceholderModule
        icon="ðŸ "
        title="Home"
        description="Your personalised home screen is coming soon."
        comingSoon
      />
    )
  }

  if (tab === 'timetable') {
    return (
      <PlaceholderModule
        icon="ðŸ“…"
        title="Timetable"
        description="View today's schedule and the weekly class timetable."
        comingSoon
      />
    )
  }

  if (tab === 'attendance') {
    return (
      <PlaceholderModule
        icon="âœ…"
        title="Attendance"
        description="Mark and review daily attendance for your classes."
        comingSoon
      />
    )
  }

  if (tab === 'students') {
    return (
      <PlaceholderModule
        icon="ðŸ‘¥"
        title="Students"
        description="Manage student records, enrolment, and guardian links."
        comingSoon
      />
    )
  }

  if (tab === 'finance') {
    return (
      <PlaceholderModule
        icon="ðŸ’°"
        title={actorType === 'guardian' ? 'Fees' : 'Finance'}
        description={
          actorType === 'guardian'
            ? "View your child's fee balance, payment history, and upcoming dues."
            : 'Record payments, manage fee structures, and view balances.'
        }
        comingSoon
      />
    )
  }

  if (tab === 'more') {
    return (
      <div className="more-menu">
        <div className="more-menu-section">
          <p className="more-menu-section-title">Modules</p>
          <MoreMenuItem icon="ðŸ“Š" label="Results" description="Scores, report cards, and promotions" />
          <MoreMenuItem icon="ðŸ“š" label="Library" description="Books, borrowing, and digital resources" />
          <MoreMenuItem icon="ðŸ“¢" label="Announcements" description="School notices and messages" />
          <MoreMenuItem icon="ðŸ—‚ï¸" label="HR" description="Staff leaves and payroll" />
        </div>

        {isAdmin && (
          <div className="more-menu-section">
            <p className="more-menu-section-title">Administration</p>
            <MoreMenuItem icon="âš™ï¸" label="Settings" description="School config, roles, and preferences" />
            <button className="more-menu-item" onClick={onOpenSetup}>
              <span className="more-menu-item-icon">ðŸ§­</span>
              <div>
                <p className="more-menu-item-label">Setup guide</p>
                <p className="more-menu-item-desc">Return to the onboarding wizard</p>
              </div>
              <span className="more-menu-item-arrow">â€º</span>
            </button>
            <MoreMenuItem icon="ðŸ“‹" label="Audit log" description="See who changed what and when" />
          </div>
        )}

        <div className="more-menu-section">
          <SignOutButton />
        </div>
      </div>
    )
  }

  return null
}

function PlaceholderModule({
  icon,
  title,
  description,
  comingSoon,
}: {
  icon: string
  title: string
  description: string
  comingSoon?: boolean
}) {
  return (
    <div className="placeholder-module">
      <span className="placeholder-icon">{icon}</span>
      <h2 className="placeholder-title">{title}</h2>
      <p className="placeholder-desc">{description}</p>
      {comingSoon && (
        <span className="coming-soon-badge">Coming in Phase 6</span>
      )}
    </div>
  )
}

function MoreMenuItem({
  icon,
  label,
  description,
}: {
  icon: string
  label: string
  description: string
}) {
  return (
    <div className="more-menu-item">
      <span className="more-menu-item-icon">{icon}</span>
      <div>
        <p className="more-menu-item-label">{label}</p>
        <p className="more-menu-item-desc">{description}</p>
      </div>
      <span className="more-menu-item-arrow">â€º</span>
    </div>
  )
}

function SignOutButton() {
  const [signingOut, setSigningOut] = useState(false)
  async function handleSignOut() {
    setSigningOut(true)
    await supabase.auth.signOut()
  }
  return (
    <button
      className="more-menu-item more-menu-item--danger"
      onClick={handleSignOut}
      disabled={signingOut}
    >
      <span className="more-menu-item-icon">ðŸšª</span>
      <div>
        <p className="more-menu-item-label">{signingOut ? 'Signing outâ€¦' : 'Sign out'}</p>
      </div>
    </button>
  )
}
